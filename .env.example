# Qreate works with NO keys (offline mode). Each key upgrades one stage.

# --- Script + critic (add at least one; free tiers are fine) ---
# https://aistudio.google.com/apikey  (recommended, free)
GEMINI_API_KEY=
# https://console.groq.com/keys       (free, very fast)
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_ORDER=gemini,groq,openai,anthropic
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Research (Wikipedia is always used; Tavily adds fresh web results) ---
# https://app.tavily.com  (free tier)
TAVILY_API_KEY=

# --- Visuals ---
# https://www.pexels.com/api/  (free) real stock footage
PEXELS_API_KEY=
# free AI images, no key
USE_POLLINATIONS=1
# Native Wan 2.1 T2V-1.3B. When ready, AI-style scenes use Wan first.
WAN_ENABLED=1
# Defaults keep the official runtime and checkpoints inside .venv.
# WAN_RUNTIME_DIR=.venv/wan2.1-runtime
# WAN_MODEL_DIR=.venv/models/wan2.1-t2v-1.3b
# WAN_SIZE=832*480
# WAN_FRAME_NUM=49
# WAN_SAMPLE_STEPS=30
# WAN_TIMEOUT=600
# WAN_OFFLOAD_MODEL=1
# WAN_T5_CPU=1

# --- Voice ---
# edge | sarvam. Sarvam = Indian neural voices (https://dashboard.sarvam.ai)
TTS_PROVIDER=edge
SARVAM_API_KEY=
# bulbul:v3 (GA). bulbul:v4-flash is beta and needs access; its speakers look like ritu_hi_reels
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya
# SARVAM_TTS_PACE=1.0
# free Microsoft neural voices, no key (also the fallback if Sarvam fails)
USE_EDGE_TTS=1
# VOICE_ENGLISH=en-IN-NeerjaNeural
# VOICE_HINGLISH=en-IN-PrabhatNeural
# VOICE_HINDI=hi-IN-SwaraNeural

# --- Pipeline ---
# videos rendered in parallel
MAX_WORKERS=2
# critic score needed before rendering
CRITIC_THRESHOLD=7.5
# max rewrites
CRITIC_MAX_ROUNDS=2
# 0 = heuristic critic, so the LLM is only used to write the script
CRITIC_USE_LLM=1
# 1 = never touch the network (demo safety net)
OFFLINE_MODE=0
